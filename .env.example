NODE_ENV=development
PORT=3000

# Central DB: superadmin, master registry, public users
MONGO_URI=mongodb://localhost:27017/codevere_central
# Base host used to build each master's isolated tenant database URI
MONGO_HOST=mongodb://localhost:27017

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Bootstrap superadmin, auto-seeded on first server start if none exists
SUPERADMIN_EMAIL=admin@codevere.com
SUPERADMIN_PASSWORD=ChangeMe123!
